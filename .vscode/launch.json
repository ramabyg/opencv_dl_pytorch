            "program": "${workspaceFolder}/week3/assignment.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/.env/bin/python"
            },
            "stopOnEntry": true

        },
        {
            "name": "C++ debug sample",
            "type": "cppvsdbg",
